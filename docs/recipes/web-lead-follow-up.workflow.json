{
	"name": "Factuarea CRM inbound lead and follow-up (sandbox)",
	"active": false,
	"settings": { "executionOrder": "v1" },
	"nodes": [
		{
			"id": "019251c0-0000-4000-8000-000000000001",
			"name": "Inbound",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2.1,
			"position": [0, 0],
			"parameters": {
				"httpMethod": "POST",
				"path": "factuarea-crm-inbound",
				"authentication": "headerAuth",
				"responseMode": "responseNode",
				"options": {}
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000002",
			"name": "Valid Source",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [220, 0],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "source-event",
							"leftValue": "={{ typeof $json.body?.eventId === 'string' && $json.body.eventId.trim().length > 0 && $json.body.eventId.length <= 180 }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000003",
			"name": "Create Lead",
			"type": "n8n-nodes-factuarea.factuareaCrm",
			"typeVersion": 1,
			"position": [440, 0],
			"onError": "continueRegularOutput",
			"parameters": {
				"resource": "lead",
				"operation": "create",
				"environment": "sandbox",
				"body": "={{ {name: $json.body.name, email: $json.body.email, source: 'manual'} }}",
				"idempotencyKey": "={{ 'inbound:' + $json.body.eventId + ':lead' }}"
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000004",
			"name": "Lead Confirmed",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [660, 0],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "lead-confirmed",
							"leftValue": "={{ $json._factuarea?.confirmed === true && !$json.error }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000005",
			"name": "Create Opportunity",
			"type": "n8n-nodes-factuarea.factuareaCrm",
			"typeVersion": 1,
			"position": [880, 0],
			"onError": "continueRegularOutput",
			"parameters": {
				"resource": "opportunity",
				"operation": "create",
				"environment": "sandbox",
				"body": "={{ {title: 'Inbound opportunity', lead_id: $json.id, amount: '125.0000', currency: 'EUR'} }}",
				"pipelineId": "",
				"stageId": "",
				"idempotencyKey": "={{ 'inbound:' + $('Inbound').item.json.body.eventId + ':opportunity' }}"
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000006",
			"name": "Opportunity Confirmed",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [1100, 0],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "opportunity-confirmed",
							"leftValue": "={{ $json._factuarea?.confirmed === true && !$json.error }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000007",
			"name": "Create Follow-Up",
			"type": "n8n-nodes-factuarea.factuareaCrm",
			"typeVersion": 1,
			"position": [1320, 0],
			"onError": "continueRegularOutput",
			"parameters": {
				"resource": "activity",
				"operation": "create",
				"environment": "sandbox",
				"body": "={{ {type: 'task', title: 'Follow up', timezone: 'Europe/Madrid'} }}",
				"targetType": "opportunity",
				"targetId": "={{ $json.id }}",
				"idempotencyKey": "={{ 'inbound:' + $('Inbound').item.json.body.eventId + ':follow-up' }}"
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000008",
			"name": "Activity Confirmed",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [1540, 0],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "activity-confirmed",
							"leftValue": "={{ $json._factuarea?.confirmed === true && $json.state === 'confirmed' && !$json.error }}",
							"rightValue": "",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "019251c0-0000-4000-8000-000000000009",
			"name": "Respond Completed",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.4,
			"position": [1760, 0],
			"parameters": {
				"respondWith": "json",
				"responseBody": "={{ {completed: true, leadId: $('Create Lead').item.json.id, opportunityId: $('Create Opportunity').item.json.id, activityId: $json.activity_id} }}",
				"options": { "responseCode": 200 }
			}
		},
		{
			"id": "019251c0-0000-4000-8000-00000000000a",
			"name": "Respond Review Required",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.4,
			"position": [1100, 300],
			"parameters": {
				"respondWith": "json",
				"responseBody": "={{ {completed: false, state: $json.error?.unconfirmed ? 'unconfirmed' : 'review_required', code: $json.error?.code || 'invalid_source_or_missing_confirmation'} }}",
				"options": { "responseCode": 409 }
			}
		}
	],
	"connections": {
		"Inbound": {
			"main": [[{ "node": "Valid Source", "type": "main", "index": 0 }]]
		},
		"Valid Source": {
			"main": [
				[{ "node": "Create Lead", "type": "main", "index": 0 }],
				[{ "node": "Respond Review Required", "type": "main", "index": 0 }]
			]
		},
		"Create Lead": {
			"main": [[{ "node": "Lead Confirmed", "type": "main", "index": 0 }]]
		},
		"Lead Confirmed": {
			"main": [
				[{ "node": "Create Opportunity", "type": "main", "index": 0 }],
				[{ "node": "Respond Review Required", "type": "main", "index": 0 }]
			]
		},
		"Create Opportunity": {
			"main": [
				[{ "node": "Opportunity Confirmed", "type": "main", "index": 0 }]
			]
		},
		"Opportunity Confirmed": {
			"main": [
				[{ "node": "Create Follow-Up", "type": "main", "index": 0 }],
				[{ "node": "Respond Review Required", "type": "main", "index": 0 }]
			]
		},
		"Create Follow-Up": {
			"main": [[{ "node": "Activity Confirmed", "type": "main", "index": 0 }]]
		},
		"Activity Confirmed": {
			"main": [
				[{ "node": "Respond Completed", "type": "main", "index": 0 }],
				[{ "node": "Respond Review Required", "type": "main", "index": 0 }]
			]
		}
	},
	"pinData": {}
}
